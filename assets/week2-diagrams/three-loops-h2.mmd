%%{init: {"theme": "base", "themeVariables": {"fontFamily": "PingFang TC, sans-serif", "fontSize": "16px", "primaryColor": "#FFFFFF", "primaryTextColor": "#2A2623", "primaryBorderColor": "#D9D4CE", "lineColor": "#6B6560", "clusterBkg": "#EEF2EF", "clusterBorder": "#EEF2EF", "edgeLabelBackground": "#FFFFFF", "tertiaryColor": "#EEF2EF"}, "flowchart": {"htmlLabels": false, "curve": "basis", "nodeSpacing": 30, "rankSpacing": 40, "padding": 12}}}%%
flowchart TD
    subgraph L1["確認方向"]
        A["帶著問題探索材料"] --> B["人決定主軸，擬定大綱"]
        B --> C["agent 整理故事線，人確認"]
        C -. 補充探索 .-> A
    end
    C -->|依方向展開| D
    subgraph L2["建立架構"]
        D["agent 起草文章"] --> E["人補入洞見，理順邏輯"]
        E --> F["agent 協助收斂，人取捨"]
        F -. 修改草稿 .-> D
    end
    E -. 新資料出現，重看方向 .-> B
    F -->|內容確定| K
    subgraph L3["調整風格"]
        K["agent 尋找規則，寫成標準"] --> I["agent 依標準產出一版"]
        I --> J["人依自身品味檢視整份"]
        J -. 改標準，重新產出 .-> K
    end
    J -. 內容問題，退回 .-> E
    J -->|確認可交付| L["交付"]
    style A fill:#FFFFFF,stroke:#ECE9E5,color:#C4BFB9
    style B fill:#FFFFFF,stroke:#ECE9E5,color:#C4BFB9
    style C fill:#FFFFFF,stroke:#ECE9E5,color:#C4BFB9
    style I fill:#FFFFFF,stroke:#ECE9E5,color:#C4BFB9
    style J fill:#FFFFFF,stroke:#ECE9E5,color:#C4BFB9
    style K fill:#FFFFFF,stroke:#ECE9E5,color:#C4BFB9
    style L fill:#FFFFFF,stroke:#ECE9E5,color:#C4BFB9
    style L1 fill:#FFFFFF,stroke:#D9D4CE
    style L3 fill:#FFFFFF,stroke:#D9D4CE
    linkStyle 0,1,2,3,8,9,10,11,12,13 stroke:#DDD9D3
    linkStyle 4,5,6,7 stroke:#B85042
    style E stroke:#B85042,stroke-width:2px
