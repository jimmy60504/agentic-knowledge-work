assets/
images/
media/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.mp4
*.mov

# Curated assets with documented sources
!assets/
!assets/site/
!assets/site/*.png

node_modules/
dist/
/_site/
/.quarto/
**/*.quarto_ipynb
/.claude/
